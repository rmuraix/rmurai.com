---
import Icon from '@/components/Icon.astro';
import { site, socialLinks } from '@/lib/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-hair py-[clamp(3rem,2rem+4vw,5rem)]">
	<div class="shell flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="mono text-ink-muted">
				<span class="text-brand" aria-hidden="true">$</span> whoami
			</p>
			<p class="mono mt-2 text-ink">
				&copy; {currentYear} {site.name}
			</p>
		</div>

		<nav class="flex flex-wrap gap-x-6 gap-y-3" aria-label="Profiles">
			{
				socialLinks.map((link) => (
					<a
						class="mono link tap inline-flex items-center gap-2 text-ink-muted hover:text-brand-bright"
						href={link.href}
						target="_blank"
						rel="me noopener noreferrer"
					>
						<Icon name={link.icon} class="size-4" />
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</footer>
