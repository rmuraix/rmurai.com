---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
	awards: (CollectionEntry<'awards'> & {
		publication?: CollectionEntry<'publications'>;
	})[];
}

const { awards } = Astro.props;
const count = awards.length;
---

<section id="awards" data-section class="section">
	<div class="shell">
		<SectionHeading
			command="awards"
			title="Recognition for published work."
			count={`${count} ${count === 1 ? 'entry' : 'entries'}`}
		/>

		<ol class="list-none p-0">
			{
				awards.map(({ data, publication }) => (
					<li class="entry" data-reveal>
						<span class="entry-rule" aria-hidden="true" />

						<div class="grid gap-x-[clamp(1.5rem,4vw,3.5rem)] gap-y-4 md:grid-cols-[6rem_1fr]">
							<p class="mono pt-[0.4em] text-brand md:text-right">{data.year}</p>

							<div class="min-w-0">
								<h3 class="entry-title font-normal tracking-[-0.015em]">
									{data.url ? (
										<>
											<a
												class="stretched-link"
												href={data.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{data.title}
											</a>
											<Icon name="arrow" class="entry-arrow ml-2 inline-block size-4 align-baseline" />
										</>
									) : (
										data.title
									)}
								</h3>

								{(publication?.data.title ?? data.paperTitle) && (
									<p class="mt-3 text-[0.9375rem] leading-[1.7] text-ink-muted">
										{publication?.data.title ?? data.paperTitle}
									</p>
								)}

								<p class="mono mt-4 text-ink">{data.event}</p>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
