---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
	publications: CollectionEntry<'publications'>[];
}

const { publications } = Astro.props;
const count = publications.length;
---

<section id="publications" data-section class="section">
	<div class="shell">
		<SectionHeading
			command="publications"
			title="Peer-reviewed papers and conference proceedings."
			count={`${count} ${count === 1 ? 'entry' : 'entries'}`}
		>
			Work on Japanese sign language recognition — word-level accuracy, point-supervised
			temporal localization, and multimodal fusion.
		</SectionHeading>

		<ol class="list-none p-0">
			{
				publications.map((publication) => (
					<li class="entry" data-reveal>
						<span class="entry-rule" aria-hidden="true" />

						<div class="grid gap-x-[clamp(1.5rem,4vw,3.5rem)] gap-y-4 md:grid-cols-[6rem_1fr]">
							<p class="mono pt-[0.4em] text-[var(--sn-accent)] md:text-right">
								{publication.data.year}
							</p>

							<div class="min-w-0">
								<h3 class="entry-title font-normal tracking-[-0.015em]">
									<a
										class="stretched-link"
										href={publication.data.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										{publication.data.title}
									</a>
									<Icon name="arrow" class="entry-arrow ml-2 inline-block size-4 align-baseline" />
								</h3>

								<p class="mt-3 text-[0.9375rem] leading-[1.7] text-[var(--sn-fg-muted)]">
									{publication.data.authors.join(', ')}
								</p>

								<div class="mono mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[var(--sn-fg-muted)]">
									<span class="text-[var(--sn-fg)]">{publication.data.venue}</span>

									{publication.data.doi && (
										<a
											class="entry-aside link text-[var(--sn-fg-muted)] hover:text-[var(--sn-accent-bright)]"
											href={`https://doi.org/${publication.data.doi}`}
											target="_blank"
											rel="noopener noreferrer"
										>
											doi:{publication.data.doi}
										</a>
									)}

									{publication.data.pdfUrl && (
										<a
											class="entry-aside link text-[var(--sn-fg-muted)] hover:text-[var(--sn-accent-bright)]"
											href={publication.data.pdfUrl}
											target="_blank"
											rel="noopener noreferrer"
										>
											pdf
										</a>
									)}
								</div>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
