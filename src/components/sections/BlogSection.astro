---
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { site } from '@/lib/site';
import type { ZennArticle } from '@/lib/zenn';

interface Props {
	articles: ZennArticle[];
	totalCount: number;
}

const { articles, totalCount } = Astro.props;

function toIsoDate(value: string) {
	const parsed = new Date(value);
	return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString().slice(0, 10);
}

function formatDate(value: string) {
	const iso = toIsoDate(value);
	return iso ? iso.replaceAll('-', '.') : value;
}
---

<section id="blog" data-section class="section">
	<div class="shell">
		<SectionHeading
			command="blog"
			title="Notes from the workbench."
			count={totalCount > 0 ? `${totalCount} posts` : undefined}
		>
			Japanese-language write-ups on research tooling, implementation details, and things
			worth remembering. Published on Zenn.
		</SectionHeading>

		{
			articles.length > 0 ? (
				<ol class="list-none p-0">
					{articles.map((article) => (
						<li class="entry" data-reveal>
							<span class="entry-rule" aria-hidden="true" />

							<div class="grid gap-x-[clamp(1.5rem,4vw,3.5rem)] gap-y-4 md:grid-cols-[6rem_1fr]">
								<p class="mono pt-[0.4em] text-brand md:text-right">
									{toIsoDate(article.publishedAt) ? (
										<time datetime={toIsoDate(article.publishedAt)}>
											{formatDate(article.publishedAt)}
										</time>
									) : (
										article.publishedAt
									)}
								</p>

								<div class="min-w-0">
									<h3 class="entry-title font-normal tracking-[-0.015em]">
										<span class="mr-2 select-none" aria-hidden="true">
											{article.emoji}
										</span>
										<a
											class="stretched-link"
											href={article.url}
											target="_blank"
											rel="noopener noreferrer"
										>
											{article.title}
										</a>
										<Icon name="arrow" class="entry-arrow ml-2 inline-block size-4 align-baseline" />
									</h3>
								</div>
							</div>
						</li>
					))}
				</ol>
			) : (
				<p class="max-w-[60ch] text-[length:var(--sn-text-body)] leading-[1.7] text-ink-muted" data-reveal>
					The feed could not be reached at build time. The full archive is still on Zenn.
				</p>
			)
		}

		<div class="mt-[clamp(2.5rem,2rem+2vw,3.5rem)]" data-reveal>
			<a class="chip mono" href={site.zenn} target="_blank" rel="noopener noreferrer">
				zenn.dev/rmuraix
				<Icon name="arrow" class="size-4" />
			</a>
		</div>
	</div>
</section>
